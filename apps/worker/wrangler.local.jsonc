{
  "name": "nexocena-api-local-test-only",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "vars": {
    "EXPERIMENT_REGISTRATION": "true",
    "EXPERIMENT_OWNER_EMAIL": "owner@example.com",
    "EXPERIMENT_REMOTE_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexocena-experimental",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "preview_database_id": "DB",
      "migrations_dir": "migrations"
    }
  ]
}
