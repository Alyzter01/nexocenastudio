# API. Nenhum segredo é necessário para o desenvolvimento local.
PORT=3001
DATA_DIR=.data
# Produção: cookies Secure; exige HTTPS no proxy reverso.
# NODE_ENV=production
# Vídeo: configurar SOMENTE no backend, nunca usar prefixo VITE_ para chaves.
# RUNWAYML_API_SECRET=
# Tarifa atual do Gen-4.5 em créditos por segundo: consultar painel/documentação Runway.
# RUNWAY_CREDITS_PER_SECOND=
# Hosts HTTPS exatos de saída autorizados pelo provedor, separados por vírgula.
# RUNWAY_OUTPUT_HOSTS=
# Em ambientes com proxy que usam Node 24:
# NODE_USE_ENV_PROXY=1

# Padrão seguro: acesso privado e cadastro bloqueado.
ACCESS_MODE=private
PRIVATE_OWNER_EMAIL=mkprod.60@gmail.com
REGISTRATION_ENABLED=false
# Produção exige origem HTTPS do frontend, sem caminho.
# APP_ORIGIN=https://studio.example.com
# Chave/tarifa não habilitam sozinhas os envios pagos.
RUNWAY_GENERATION_ENABLED=false
# Teto global de créditos estimados em janela móvel de 24h (0 bloqueia envios).
RUNWAY_DAILY_CREDIT_LIMIT=0
# BACKUP_DIR=/diretorio-seguro/novo-snapshot

# Supabase (somente backend; não publicar no frontend)
# DATABASE_URL=postgresql://... (obter do painel Supabase, nunca commitar)
SUPABASE_URL=https://kdwtbefpbcyendvtuufb.supabase.co
SUPABASE_STORAGE_BUCKET=nexocena-media
# SUPABASE_SECRET_KEY= (segredo do servidor, configurar somente no Render)
# Persistência PostgreSQL/Storage só estará ativa após migrar apps/api/src/server.ts e generation.ts.
