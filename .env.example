# Somente backend. Não há credenciais reais neste arquivo.
NODE_ENV=production
ACCESS_MODE=private
PRIVATE_OWNER_EMAIL=mkprod.60@gmail.com
REGISTRATION_ENABLED=false
APP_ORIGIN=https://nexocenastudio.vercel.app
# APP_PREVIEW_ORIGINS=https://preview-exato.vercel.app
DB_POOL_MAX=2
# DATABASE_URL= (conexão PostgreSQL/Supavisor obtida no painel, manter secreta)
# DATABASE_SSL_CA= (CA oficial PEM se a cadeia não estiver no trust store)
SUPABASE_URL=https://kdwtbefpbcyendvtuufb.supabase.co
SUPABASE_STORAGE_BUCKET=nexocena-media
# SUPABASE_SECRET_KEY= (secret key moderna ou service_role legada, só backend)
RUNWAY_GENERATION_ENABLED=false
RUNWAY_DAILY_CREDIT_LIMIT=0
# PORT é fornecida pelo Render; padrão local 3001.
# Em infraestrutura que usa proxy herdado: NODE_USE_ENV_PROXY=1

# Somente build Vercel, não usar prefixo VITE_ nem colocar segredo:
# API_ORIGIN=https://URL-REAL-DA-API.onrender.com

# Somente manutenção/desenvolvimento:
# DATA_DIR=/caminho/absoluto/sqlite-local
# SQLITE_IMPORT_DIR=/copia-local-preservada
# IMPORT_MAX_STORAGE_BYTES= (orçamento de bytes confirmado antes de --apply)
# BACKUP_DIR=/destino-local-privado-novo
# DATABASE_SSL=false é permitido apenas fora de NODE_ENV=production.
# Para dev local sem PostgreSQL: ACCESS_MODE=multiuser REGISTRATION_ENABLED=true
